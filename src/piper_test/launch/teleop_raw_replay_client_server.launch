<launch>
  <!--
    New launch (does not modify old replay launch):
    - starts 2x piper_ctrl_single_node
    - starts network replay client that receives actions from server

    Start server separately:
      python3 /home/jinhe/Desktop/piper_master_slave_ws/piper_master_slave_ws/lerobot-server/hdf5_action_server.py
  -->

  <arg name="server_ip" default="127.0.0.1" />
  <arg name="server_port" default="5560" />

  <arg name="slave1_name" default="slave1" />
  <arg name="slave2_name" default="slave2" />
  <arg name="slave1_can" default="slave1" />
  <arg name="slave2_can" default="slave2" />

  <arg name="do_reset" default="true" />
  <arg name="ready_timeout_sec" default="8.0" />
  <arg name="reset_timeout_sec" default="12.0" />
  <arg name="reset_err_thresh" default="0.03" />
  <arg name="max_joint_speed_rad_s" default="0.10" />

  <group ns="$(arg slave1_name)">
    <node pkg="piper" type="piper_ctrl_single_node.py" name="piper_ctrl_single_node" output="screen">
      <param name="can_port" value="$(arg slave1_can)" />
      <param name="auto_enable" value="true" />
      <param name="girpper_exist" value="true" />
      <param name="gripper_val_mutiple" value="1" />
    </node>
  </group>

  <group ns="$(arg slave2_name)">
    <node pkg="piper" type="piper_ctrl_single_node.py" name="piper_ctrl_single_node" output="screen">
      <param name="can_port" value="$(arg slave2_can)" />
      <param name="auto_enable" value="true" />
      <param name="girpper_exist" value="true" />
      <param name="gripper_val_mutiple" value="1" />
    </node>
  </group>

  <node pkg="piper_test"
        type="act_client_ros_2arm3cam_state14.py"
        name="act_client_ros_2arm3cam_state14"
        output="screen"
        required="true">
    <param name="server_ip" value="$(arg server_ip)" />
    <param name="server_port" value="$(arg server_port)" />

    <param name="slaves" value="$(arg slave1_name),$(arg slave2_name)" />
    <param name="cmd_topic_tpl" value="/{slave}/joint_ctrl_single" />
    <param name="state_topic_tpl" value="/{slave}/joint_states_single" />

    <param name="do_reset" value="$(arg do_reset)" />
    <param name="ready_timeout_sec" value="$(arg ready_timeout_sec)" />
    <param name="reset_timeout_sec" value="$(arg reset_timeout_sec)" />
    <param name="reset_err_thresh" value="$(arg reset_err_thresh)" />
    <param name="max_joint_speed_rad_s" value="$(arg max_joint_speed_rad_s)" />

    <param name="joint_velocity_default" value="0.0" />
    <param name="joint_effort_default" value="0.0" />
    <param name="gripper_velocity" value="100.0" />
    <param name="gripper_effort" value="1.0" />
  </node>
</launch>
